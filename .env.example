# Copy to .env and edit. `./setup.sh` generates secrets and renders the Caddyfile.

# Public issuer host (CNAME -> this VPS, DNS-only / grey cloud). Authentik's OIDC
# issuer lives under https://<ID_HOST>/application/o/<app>/.
ID_HOST=id.example.com

# Hosts whose Caddy does forward auth against Authentik's embedded outpost
# (e.g. iroha's live site): their public IPs/CIDRs, space-separated, so
# Authentik trusts their X-Forwarded-Host/Proto. Empty = trust none.
ID_TRUSTED_PROXIES=

# Generated by setup.sh on first run — leave empty.
AUTHENTIK_SECRET_KEY=
PG_PASS=

# SMTP for verification / password-reset emails (Resend). Fill when ready; until
# then email features just don't send. Single-quote the API key.
AUTHENTIK_EMAIL__HOST=smtp.resend.com
AUTHENTIK_EMAIL__PORT=587
AUTHENTIK_EMAIL__USERNAME=resend
AUTHENTIK_EMAIL__PASSWORD=''
AUTHENTIK_EMAIL__USE_TLS=true
AUTHENTIK_EMAIL__FROM=Lore <noreply@id.example.com>

# --- Automated updates (ops/update.sh; see README) — all optional ---
# URL to POST deploy/failure notices to, e.g. an ntfy.sh topic. Empty = journal only.
UPDATE_NOTIFY_URL=
# UPDATE_BRANCH=main
# UPDATE_BACKUP_DIR=/var/backups/<stack>
# UPDATE_BACKUP_KEEP=5
